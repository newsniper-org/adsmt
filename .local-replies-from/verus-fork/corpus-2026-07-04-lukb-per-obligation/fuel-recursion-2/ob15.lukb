axiom: forall x: Poly. has_type(x, CHAR) ==> x = I(`%I`(x)) trigger has_type(x, CHAR)
axiom: forall x: Poly. has_type(x, REAL) ==> x = R(`%R`(x)) trigger has_type(x, REAL)
