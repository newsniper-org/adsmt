axiom: forall i: Int. 0 <= nClip(i) and (0 <= i ==> i = nClip(i)) trigger nClip(i)
axiom: forall bits: Int, i: Int. 0 <= uClip(bits, i) and uClip(bits, i) < uHi(bits) and (0 <= i and i < uHi(bits) ==> i = uClip(bits, i)) trigger uClip(bits, i)
axiom: forall bits: Int, i: Int. iLo(bits) <= iClip(bits, i) and iClip(bits, i) < iHi(bits) and (iLo(bits) <= i and i < iHi(bits) ==> i = iClip(bits, i)) trigger iClip(bits, i)
axiom: forall i: Int. (0 <= charClip(i) and charClip(i) <= 55295 or 57344 <= charClip(i) and charClip(i) <= 1114111) and (0 <= i and i <= 55295 or 57344 <= i and i <= 1114111 ==> i = charClip(i)) trigger charClip(i)
