axiom: forall x: Poly. has_type(x, NAT) ==> x = I(`%I`(x)) trigger has_type(x, NAT)
axiom: forall x: Poly. has_type(x, USIZE) ==> x = I(`%I`(x)) trigger has_type(x, USIZE)
axiom: forall x: Poly. has_type(x, ISIZE) ==> x = I(`%I`(x)) trigger has_type(x, ISIZE)
