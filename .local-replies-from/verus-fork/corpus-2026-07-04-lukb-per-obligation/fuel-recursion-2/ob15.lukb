axiom: forall bits: Int, i: Int. iInv(bits, i) = (iLo(bits) <= i and i < iHi(bits)) trigger iInv(bits, i)
axiom: forall i: Int. charInv(i) = (0 <= i and i <= 55295 or 57344 <= i and i <= 1114111) trigger charInv(i)
