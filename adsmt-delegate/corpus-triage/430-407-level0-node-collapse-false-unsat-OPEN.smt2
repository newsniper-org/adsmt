(set-logic ALL)
(declare-sort U 0)
(declare-fun c0 () U)
(declare-fun c1 () U)
(declare-fun c2 () U)
(declare-fun f0 (U) U)
(declare-fun f1 (U) U)
(declare-fun g0 (U U) U)
(declare-fun g1 (U U) U)
(declare-fun h0 (U) Int)
(assert (= (h0 (f0 c2)) (+ (h0 c0) 1)))
(assert (or (= (f0 c2) c0) (= (g0 (g1 c1 c1) c0) c2)))
(assert (=> (not (= (g0 (f0 c2) (f1 c1)) (f0 (f0 c0)))) (not (= c1 c2))))
(check-sat)
(exit)
