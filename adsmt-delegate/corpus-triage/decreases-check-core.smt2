(set-logic ALL)
(declare-sort P 0)
(declare-sort E 0)
(declare-fun Lit (Int) E)
(declare-fun Lit!sel0 (E) Int)
(declare-fun Add (E E) E)
(declare-fun Add!sel0 (E) E)
(declare-fun Add!sel1 (E) E)
(declare-fun unbox (P) E)
(declare-fun box (E) P)
(declare-fun height (P) Int)
(declare-fun height_lt (Int Int) Bool)
(declare-fun neg0 (E) E)
(declare-const e P)
(assert (forall ((x E)) (=> (and (not (= x (Lit (Lit!sel0 x)))) (not (= x (Add (Add!sel0 x) (Add!sel1 x))))) (height_lt (height (box (neg0 x))) (height (box x))))))
(assert (not (= (unbox e) (Lit (Lit!sel0 (unbox e))))))
(assert (not (= (unbox e) (Add (Add!sel0 (unbox e)) (Add!sel1 (unbox e))))))
(assert (not (height_lt (height (box (neg0 (unbox e)))) (height (box (unbox e))))))
(check-sat)
