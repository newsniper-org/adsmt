(set-logic ALL)
(declare-sort U 0)
(declare-fun c0 () U)
(declare-fun c1 () U)
(declare-fun c2 () U)
(declare-fun f0 (U) U)
(declare-fun f1 (U) U)
(declare-fun f2 (U) U)
(declare-fun f3 (U) U)
(declare-fun g0 (U U) U)
(declare-fun g1 (U U) U)
(declare-fun g2 (U U) U)
(declare-fun h0 (U) Int)
(declare-fun h1 (U) Int)
(declare-fun n () Int)
(assert (= (f0 (f0 c2)) c1))
(assert (or (= (g2 c0 (f3 c2)) c2) (not (= c1 (g2 c2 (f0 c2))))))
(assert (= c0 (f0 c2)))
(assert (or (not (= c1 (g0 c0 (f1 c0)))) (= (f0 c2) (g2 (g0 c0 c1) (f1 c0)))))
(check-sat)
(push 1)
(assert (= (f2 (g2 c1 c0)) (g2 c2 (f0 c2))))
(assert (=> (= c1 (g2 c2 (g0 c0 c0))) (= (h1 c0) n)))
(assert (not (= (f0 c2) c0)))
(assert (and (= 0 (h0 c2)) (not (= c1 c2))))
(check-sat)
(push 1)
(assert (= (h0 (g0 (f2 c0) (f0 c2))) (h1 (g0 (g1 c1 c1) c1))))
(check-sat)
(pop 1)
(assert (= c2 c2))
(check-sat)
(pop 1)
(check-sat)
(exit)
