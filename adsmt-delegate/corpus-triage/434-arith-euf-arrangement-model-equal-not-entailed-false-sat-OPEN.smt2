(set-logic QF_UFLIA)
(declare-fun x0 () Int) (declare-fun x1 () Int)
(declare-fun a () Int) (declare-fun b () Int)
(declare-fun f0 (Int) Int) (declare-fun f1 (Int) Int)
(assert (>= (* 2 x0) 5))
(assert (not (<= 5 x0)))
(assert (= (f1 3) a))
(assert (not (= (f1 x0) a)))
(assert (= (f0 3) a))
(assert (= (f0 x1) b))
(assert (not (= a b)))
(assert (= x0 (+ x1 1)))
(check-sat)
