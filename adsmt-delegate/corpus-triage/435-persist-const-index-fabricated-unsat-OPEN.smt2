(set-logic QF_UFLIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(declare-fun v0 () Int)
(declare-fun v1 () Int)
(declare-fun h0 (Int) Int)
(assert (<= -1 x0))
(assert (<= x0 1))
(assert (= x1 (+ x0 2)))
(assert (= x0 (+ x2 1)))
(assert (= (h0 -4) v1))
(assert (= (h0 -2) v0))
(assert (= (h0 0) v1))
(assert (= (h0 1) v0))
(assert (= (h0 x1) v0))
(assert (= (h0 x2) v0))
(assert (= (h0 x0) v0))
(assert (not (= v0 v1)))
(check-sat)
