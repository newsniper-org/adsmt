/target/
**/*.rs.bk

# Lake (Lean 4) build cache — all artifacts live under .lake/.
# `lake-manifest.json` and `lakefile.toml` stay tracked.
**/.lake/

.idea/
.vscode/
*.swp

.DS_Store

docs/upstream/*.md

# perf / flamegraph raw captures — large binaries, regenerated
# per profiling run; only the .txt/.svg digests are committed.
*.data
perf.data
perf.data.old

.claude-conversations/precompact-backups*.md

# Research library — third-party copyrighted PDFs held for private study;
# the README.md index is the only intentionally-shareable file. Kept out of
# git so `git add -A` never stages the ~5.6 MB of papers.
.claude-research-library/